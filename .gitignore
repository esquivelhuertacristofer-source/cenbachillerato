# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# development backups
*.bak

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# secrets locales de Cloudflare (NUNCA commitear: contiene service_role)
.dev.vars

# vercel / cloudflare build output
.vercel
.wrangler
.open-next/

# typescript
*.tsbuildinfo
next-env.d.ts

# local audit / build logs (no commitear)
audit-*.log
audit-*.json
cf-build.log
pages-build-audit.log
_diagnostico-*.log

# inspección temporal de paquetes (no commitear)
tmp-inspect/

# salidas generadas por los scripts (reportes, volcados) — se regeneran, no son fuente
scripts/out/
# consultas de un solo uso (no commitear)
scripts/tmp-*

# Material fuente oficial 2025 (PDFs grandes) — solo local, no se despliega
docs/fuentes-oficiales-2025/
